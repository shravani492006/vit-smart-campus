PORT=4000
NODE_ENV=development
# Comma-separated list of allowed frontend origins ("*" = any, fine for local dev)
CORS_ORIGIN=http://localhost:5173,http://localhost:8443
# Required for /api/v1/admin/* endpoints. CHANGE THIS.
ADMIN_API_KEY=change-me-please
# JSON file used for mutable data (saved places, reports, overrides). Use :memory: for none.
DB_PATH=storage/db.json
# Walking speed used for time estimates (metres / second)
WALK_SPEED_MPS=1.3
# Node used when the client sends "current_location" (no GPS/indoor positioning yet)
DEFAULT_ORIGIN_NODE=entrance
# Base URL of the standalone Python AI Navigation service (see ../python-ai). Used by /api/v1/ai/*.
PYTHON_AI_URL=http://localhost:8000
